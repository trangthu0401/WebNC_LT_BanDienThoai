@model WebBanDienThoai.Models.ViewModels.ProductEditViewModel

@{
    ViewData["Title"] = "Chỉnh sửa Sản phẩm";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-10">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-light py-3">
                    <h4 class="mb-0">Chỉnh sửa Sản phẩm (ID: @Model.Product.ProductId)</h4>
                </div>

                <form asp-action="Edit" asp-controller="Product" method="post" enctype="multipart/form-data">

                    <input type="hidden" asp-for="Product.ProductId" />
                    <input type="hidden" asp-for="Product.MainImage" />
                    <input type="hidden" asp-for="Product.CreatedDate" />

                    <div class="card-body p-4">
                        <div class="row g-4">

                            <div class="col-md-7">
                                <h5 class="mb-3">Thông tin chung</h5>

                                <div class="mb-3">
                                    <label asp-for="Product.Name" class="form-label">Tên sản phẩm</label>
                                    <input asp-for="Product.Name" class="form-control" />
                                    <span asp-validation-for="Product.Name" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.BrandId" class="form-label">Hãng sản xuất</label>
                                    <select asp-for="Product.BrandId" class="form-select" asp-items="@Model.BrandList">
                                        <option value="">-- Chọn hãng --</option>
                                    </select>
                                    <span asp-validation-for="Product.BrandId" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Description" class="form-label">Mô tả</label>
                                    <textarea asp-for="Product.Description" class="form-control" rows="10"></textarea>
                                    <span asp-validation-for="Product.Description" class="text-danger"></span>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" asp-for="Product.IsActive">
                                    <label class="form-check-label" asp-for="Product.IsActive">
                                        Hiển thị (Đang bán)
                                    </label>
                                </div>

                                <div class="form-check mb-3">
                                    <input class="form-check-input" type="checkbox" asp-for="Product.ChargerIncluded" value="true">
                                    <label class="form-check-label" asp-for="Product.ChargerIncluded">
                                        Có kèm sạc
                                    </label>
                                </div>

                            </div>

                            <div class="col-md-5">
                                <h5 class="mb-3">Thông số kỹ thuật</h5>

                                <div class="mb-3">
                                    <label asp-for="Product.ReleaseDate" class="form-label">Ngày ra mắt</label>
                                    <input asp-for="Product.ReleaseDate" type="date" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Chipset" class="form-label">Chipset</label>
                                    <input asp-for="Product.Chipset" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.OperatingSystem" class="form-label">Hệ điều hành</label>
                                    <input asp-for="Product.OperatingSystem" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.ScreenSize" class="form-label">Kích thước màn hình (inch)</label>
                                    <input asp-for="Product.ScreenSize" type="number" step="0.01" class="form-control no-spinner" min="0" />
                                    <span asp-validation-for="Product.ScreenSize" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.ScreenTech" class="form-label">Công nghệ màn hình</label>
                                    <input asp-for="Product.ScreenTech" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.RefreshRate" class="form-label">Tần số quét (Hz)</label>
                                    <input asp-for="Product.RefreshRate" type="number" class="form-control no-spinner" min="0" />
                                    <span asp-validation-for="Product.RefreshRate" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.BatteryCapacity" class="form-label">Dung lượng Pin (mAh)</label>
                                    <input asp-for="Product.BatteryCapacity" type="number" class="form-control no-spinner" min="0" />
                                    <span asp-validation-for="Product.BatteryCapacity" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.RearCamera" class="form-label">Camera sau</label>
                                    <input asp-for="Product.RearCamera" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.FrontCamera" class="form-label">Camera trước</label>
                                    <input asp-for="Product.FrontCamera" class="form-control" />
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Weight" class="form-label">Trọng lượng (gram)</label>
                                    <input asp-for="Product.Weight" type="number" step="0.01" class="form-control no-spinner" min="0" />
                                    <span asp-validation-for="Product.Weight" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Product.Dimensions" class="form-label">Kích thước (mm)</label>
                                    <input asp-for="Product.Dimensions" class="form-control" />
                                </div>

                                <hr />
                                <h5 class="mb-3">Ảnh đại diện</h5>
                                <div class="mb-3">
                                    <label asp-for="MainImageFile" class="form-label">Tải ảnh mới (Bỏ trống nếu không muốn đổi)</label>
                                    <input asp-for="MainImageFile" class="form-control" type="file" accept="image/*">
                                </div>

                                @if (!string.IsNullOrEmpty(Model.Product.MainImage))
                                {
                                    <div class="mb-3">
                                        <label class="form-label">Ảnh hiện tại:</label>
                                        <img src="@Url.Content(Model.Product.MainImage)" alt="Ảnh chính" class="img-thumbnail" style="max-width: 200px;" />
                                    </div>
                                }

                            </div>
                        </div>
                    </div>

                    <div class="card-footer bg-light text-end py-3">
                        <a asp-action="Index" asp-controller="Product" class="btn btn-secondary">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Lấy tất cả input number có class no-spinner
            const numberInputs = document.querySelectorAll('input[type="number"].no-spinner');

            numberInputs.forEach(input => {
                // 1. Chặn nhập ký tự e, +, -
                input.addEventListener('keydown', function(e) {
                    if (['e', 'E', '+', '-'].includes(e.key)) {
                        e.preventDefault();
                    }
                });

                // 2. Kiểm tra khi paste dữ liệu
                input.addEventListener('paste', function(e) {
                    const pasteData = e.clipboardData.getData('text');
                    if (pasteData && (pasteData.includes('-') || pasteData.includes('+') || isNaN(pasteData))) {
                        e.preventDefault();
                        showToast('error', 'Vui lòng chỉ nhập số dương!');
                    }
                });

                // 3. Kiểm tra khi rời khỏi ô nhập (blur)
                input.addEventListener('blur', function() {
                    if (this.value && parseFloat(this.value) < 0) {
                        this.value = Math.abs(parseFloat(this.value)); // Tự động chuyển thành số dương
                        showToast('warning', 'Đã tự động sửa thành số dương.');
                    }
                });
            });
        });

        // Hàm hiển thị thông báo nhỏ
        function showToast(type, message) {
            const toastContainer = document.getElementById('toast-container') || createToastContainer();
            const toast = document.createElement('div');
            toast.className = `toast align-items-center text-white bg-${type === 'error' ? 'danger' : 'warning'} border-0 show`;
            toast.role = 'alert';
            toast.innerHTML = `
                <div class="d-flex">
                    <div class="toast-body">${message}</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                </div>
            `;
            toastContainer.appendChild(toast);

            // Tự xóa sau 3s
            setTimeout(() => toast.remove(), 3000);
        }

        function createToastContainer() {
            const div = document.createElement('div');
            div.id = 'toast-container';
            div.className = 'toast-container position-fixed bottom-0 end-0 p-3';
            div.style.zIndex = '1100';
            document.body.appendChild(div);
            return div;
        }
    </script>
}

<style>
    /* Ẩn nút tăng giảm mặc định của trình duyệt */
    input[type=number]::-webkit-inner-spin-button,
    input[type=number]::-webkit-outer-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    input[type=number] {
        -moz-appearance: textfield; /* Firefox */
    }
</style>