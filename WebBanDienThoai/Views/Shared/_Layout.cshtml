<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rabit Store</title>

    <link rel="stylesheet" href="~/css/style.css" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <header class="site-header">
        <div class="header-top">
            <div class="container header-top-container">

                <a asp-controller="Home" asp-action="Index" class="logo">
                    <h1 class="logo-text">Rabit</h1>
                    <img src="~/img/linhvatcau.png" alt="Rabit Mascot" class="logo-mascot">
                    <h1 class="logo-text">Store</h1>
                </a>

                <form class="search-form">
                    <input type="text" placeholder="Tìm kiếm" class="search-input">
                    <button type="submit" class="search-button">
                        <img src="~/img/search.png" alt="Search Icon">
                    </button>
                </form>

                <div class="header-actions">
                    <a asp-controller="Cart" asp-action="Index" class="cart-link">
                        <span>Giỏ hàng</span>
                        <img src="~/img/giohang.png" alt="Cart Icon">
                    </a>
                    <a asp-controller="Account" asp-action="Profile" class="user-profile">
                        <span>Trung</span>
                        <img src="~/img/user.png" alt="User Icon">
                    </a>
                </div>
            </div>
        </div>
        <nav class="main-nav">
            <div class="container nav-container">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <a asp-controller="Account" asp-action="Favorites">Yêu thích</a>
                <a href="#" class="dropdown-link">
                    Danh mục
                    <img src="~/img/chevron-down.png" alt="Dropdown arrow">
                </a>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">

        @RenderBody()

    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>