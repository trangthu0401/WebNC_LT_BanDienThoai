<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebBanDienThoai</title> @* Giữ tên Project Mới *@

    @* --- THƯ VIỆN BẮT BUỘC --- *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/WebBanDienThoai.styles.css" asp-append-version="true" />

    @* --- CSS TÙY CHỈNH TỪ BÀI LÀM CŨ --- *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /> @* CSS cơ bản của VS/Bootstrap *@
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" /> @* CSS Tùy chỉnh của bạn *@

    @* Cho phép các View tùy chỉnh thêm CSS/JS vào HEAD (Cần cho Razor Pages nếu vẫn dùng) *@
    @await RenderSectionAsync("Head", required: false)
</head>

<body>
    @* ---------------------------------------------------- *@
    @* --- HEADER CHUYÊN NGHIỆP TỪ BÀI LÀM CŨ (RabitStore) --- *@
    @* ---------------------------------------------------- *@
    <header id="section-header" class="site-header">
        <div class="header-top">
            <div class="container header-top-container">
                <a href="#home" class="logo">
                    <span class="logo-text-r">Rabit</span>
                    <img src="~/Images/linhvatcau.png" alt="Logo" class="logo-mascot" />
                    <span class="logo-text-s">Store</span>
                </a>
                <form class="search-form">
                    <input type="search" placeholder="Tìm kiếm" class="search-input">
                    <button type="submit" class="search-button">
                        <img src="~/Images/search.png" alt="Search Icon">
                    </button>
                </form>
                <div class="header-actions">
                    <a href="#cart" class="cart-link">
                        <span>Giỏ hàng</span>
                        <img src="~/Images/giohang.png" alt="Cart Icon">
                    </a>
                    <a href="#profile" class="user-profile">
                        <span>Trung</span>
                        <img src="~/Images/user.png" alt="User Icon">
                    </a>
                </div>
            </div>
        </div>
        <nav class="main-navigation">
            <div class="container">
                <ul class="nav-list">
                    <li><a asp-controller="Home" asp-action="Index">Trang chủ</a></li> @* Sửa Tag Helper *@
                    <li><a href="#favorites">Yêu thích</a></li>
                    <li>
                        <a asp-controller="Products" asp-action="Index">
                            @* Sửa Tag Helper *@
                            Danh mục
                            <img src="~/Images/chevron-down.png" alt="Dropdown Icon" class="dropdown-icon">
                        </a>
                    </li>
                </ul>
            </div>
        </nav>
    </header>

    @* ---------------------------------------------------- *@
    @* --- MAIN CONTENT --- *@
    @* ---------------------------------------------------- *@
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* ---------------------------------------------------- *@
    @* --- FOOTER VÀ SCRIPTS --- *@
    @* ---------------------------------------------------- *@
    <footer class="border-top footer text-muted">
        <div class="container text-center py-3">
            &copy; 2025 - WebBanDienThoai - <a asp-controller="Home" asp-action="Privacy">Privacy</a> @* Sửa Tag Helper *@
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/main.js" asp-append-version="true"></script> @* Giữ script của bạn *@

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>