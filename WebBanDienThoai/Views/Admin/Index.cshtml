@model WebBanDienThoai.Models.ViewModels.DashboardViewModel

@{
    Layout = "~/Views/Shared/Admin_Layout1.cshtml";
    ViewData["Title"] = "Tổng quan";

    // Lấy Năm/Tháng hiện tại để làm giá trị mặc định cho dropdown
    var currentYear = DateTime.Now.Year;
    var currentMonth = DateTime.Now.Month;
}

<div class="content-body">
    <h1 class="content-title">Tổng quan</h1>
    <link href="~/css/Dashboard.css" rel="stylesheet" />

    @* --- CÁC THẺ THỐNG KÊ (4 THẺ TRÊN CÙNG) --- *@
    <section class="stats-grid">
        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Doanh thu</p>
                <p class="stat-card-value">@Model.TotalRevenue.ToString("0") ₫</p>
            </div>
            <div class="stat-card-icon icon-revenue">
                <img src="~/Images/Admin/Dashboard/admin_money_ic.png" alt="Revenue Icon" />
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Sản phẩm</p>
                <p class="stat-card-value">@Model.ProductCount</p>
            </div>
            <div class="stat-card-icon icon-products">
                <img src="~/Images/Admin/Dashboard/admin_product_icon.png" alt="Products Icon" />
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Người dùng</p>
                <p class="stat-card-value">@Model.UserCount</p>
            </div>
            <div class="stat-card-icon icon-users">
                <img src="~/Images/Admin/Dashboard/admin_user_ic.png" alt="Users Icon" />
            </div>
        </div>
        <div class="stat-card">
            <div class="stat-card-info">
                <p class="stat-card-title">Đơn hàng</p>
                <p class="stat-card-value">@Model.OrderCount</p>
            </div>
            <div class="stat-card-icon icon-orders">
                <img src="~/Images/Admin/Dashboard/admin_gift_ic.png" alt="Orders Icon" />
            </div>
        </div>
    </section>

    @* --- BIỂU ĐỒ DOANH THU (ĐÃ SỬA VỚI DROPDOWN) --- *@
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">Doanh thu theo ngày</h5>

                    @* === THAY THẾ NÚT BẰNG DROPDOWN LỌC === *@
                    <div class="d-flex" style="gap: 10px;">
                        <select id="revenueMonthSelect" class="form-select form-select-sm" style="width: 120px;">
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i" selected="@(i == currentMonth)">Tháng @i</option>
                            }
                        </select>
                        <select id="revenueYearSelect" class="form-select form-select-sm" style="width: 100px;">
                            @for (int i = currentYear; i >= currentYear - 3; i--)
                            {
                                <option value="@i">@i</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="card-body">
                    <canvas id="myRevenueChart"></canvas> @* Canvas cho biểu đồ Doanh thu *@
                </div>
            </div>
        </div>
    </div>



    @* --- BẢNG SẢN PHẨM BÁN CHẠY (Bên dưới) --- *@
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h3 class="h5 mb-0">Sản phẩm bán chạy</h3>
            <div class="dropdown">
                <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    Tháng 10
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="#">Tháng 9</a></li>
                    <li><a class="dropdown-item" href="#">Tháng 8</a></li>
                </ul>
            </div>
        </div>

        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Tên sản phẩm</th>
                        <th scope="col">Số lượng bán</th>
                        <th scope="col">Giá</th>
                        <th scope="col">Trạng thái</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.TopSellingProducts)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@Url.Content(product.ImageUrl ?? "~/images/placeholder.png")" alt="@product.ProductName" style="width: 40px; height: 40px; border-radius: 0%; object-fit: cover; margin-right: 10px;">
                                    <span>@product.ProductName</span>
                                </div>
                            </td>
                            <td>@product.QuantitySold</td>
                            <td>@product.Price.ToString("C0")</td>
                            <td>
                                @if (product.Stock > 20)
                                {
                                    <span class="badge rounded-pill bg-success">Còn hàng</span>
                                }
                                else if (product.Stock > 0)
                                {
                                    <span class="badge rounded-pill bg-warning text-dark">Sắp hết</span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-danger">Hết hàng</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@* ================================================================== *@
@* === TOÀN BỘ SCRIPT ĐÃ ĐƯỢC CẬP NHẬT ĐỂ LỌC THEO NGÀY/THÁNG === *@
@* ================================================================== *@
@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

           

            // =============================================
            // === BIỂU ĐỒ 2: DOANH THU THEO NGÀY (Nâng cấp) ===
            // =============================================

            let myRevenueChartInstance = null;
            const revenueCanvas = document.getElementById('myRevenueChart').getContext('2d');
            const monthSelect = document.getElementById('revenueMonthSelect');
            const yearSelect = document.getElementById('revenueYearSelect');

            /**
             * Hàm chính: Gọi API và vẽ biểu đồ doanh thu theo ngày
      
             */
            function fetchAndDrawRevenueChart(year, month) {
                // 1. Gọi API (ví dụ: /Admin/GetRevenueByDay?year=2025&month=10)
                fetch(`/Admin/GetRevenueByDay?year=${year}&month=${month}`)
                    .then(response => {
                        if (!response.ok) throw new Error('Lỗi khi gọi API doanh thu');
                        return response.json();
                    })
                    .then(revenueData => {
                        // 2. HỦY biểu đồ cũ đi nếu nó đã tồn tại
                        if (myRevenueChartInstance) {
                            myRevenueChartInstance.destroy();
                        }

                        // 3. Vẽ biểu đồ mới
                        myRevenueChartInstance = new Chart(revenueCanvas, {
                            type: 'line', // Biểu đồ miền
                            data: {
                                labels: revenueData.labels, // ["Ngày 1", "Ngày 2", ...]
                                datasets: [{
                                    label: `Doanh thu (Tháng ${month}/${year})`,
                                    data: revenueData.data,
                                    fill: true,
                                    backgroundColor: 'rgba(75, 192, 192, 0.2)',
                                    borderColor: 'rgba(75, 192, 192, 1)',
                                    tension: 0.1,
                                    borderWidth: 1
                                }]
                            },
                            options: {
                                responsive: true,
                                scales: {
                                    y: {
                                        beginAtZero: true,
                                        ticks: {
                                            callback: function(value) {
                                                if (value >= 1000000) {
                                                    return (value / 1000000) + ' Tr';
                                                }
                                                return new Intl.NumberFormat('vi-VN').format(value);
                                            }
                                        }
                                    }
                                }
                            }
                        });
                    })
                    .catch(error => console.error('Lỗi khi vẽ biểu đồ doanh thu:', error));
            }

            // --- XỬ LÝ SỰ KIỆN KHI THAY ĐỔI DROPDOWN ---
            function updateChart() {
                const selectedYear = yearSelect.value;
                const selectedMonth = monthSelect.value;
                fetchAndDrawRevenueChart(selectedYear, selectedMonth);
            }

            monthSelect.addEventListener('change', updateChart);
            yearSelect.addEventListener('change', updateChart);

            // --- TẢI LẦN ĐẦU ---
            // Tự động vẽ biểu đồ cho tháng/năm hiện tại khi tải trang
            fetchAndDrawRevenueChart(@currentYear, @currentMonth);

        });
    </script>
}